# Minimal stubs for fontTools.fontBuilder: only the surface this repo calls,
# which builds a small TrueType font in a test.

from collections.abc import Mapping, Sequence
from typing import BinaryIO

from fontTools.ttLib import _Glyph

class FontBuilder:
  def __init__(self, unitsPerEm: int, isTTF: bool) -> None: ...
  def setupGlyphOrder(self, glyphOrder: Sequence[str]) -> None: ...
  def setupCharacterMap(self, cmapping: Mapping[int, str]) -> None: ...
  def setupGlyf(self, glyphs: Mapping[str, _Glyph]) -> None: ...
  # Each glyph's advance width and left side bearing, in font units.
  def setupHorizontalMetrics(
    self, metrics: Mapping[str, tuple[int, int]]
  ) -> None: ...
  def setupHorizontalHeader(self) -> None: ...
  def setupPost(self) -> None: ...
  def save(self, file: BinaryIO) -> None: ...
